// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ShotStatus {
  PLANNED
  PROMPTING
  GENERATING
  REVIEW
  APPROVED
  NEEDS_REWORK
}

enum TakeStatus {
  GENERATING
  READY
  REJECTED
  SELECTED
}

enum JobType {
  IMAGE_TO_VIDEO
  UPSCALE
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model Project {
  id                  String        @id @default(cuid())
  title               String
  description         String?
  status              ProjectStatus @default(PLANNING)
  youtubeUrl          String?
  styleGuide          String?
  referenceImagePath  String?
  fixedNegativePrompt String?
  defaultWidth        Int           @default(768)
  defaultHeight       Int           @default(432)
  defaultFps          Int           @default(24)
  shots               Shot[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Shot {
  id               String     @id @default(cuid())
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String
  order            Int
  title            String?
  description      String?
  prompt           String?
  stillPrompt      String?
  motionPrompt     String?
  negativePrompt   String?
  aiTool           String?
  durationSeconds  Float?
  status           ShotStatus @default(PLANNED)
  notes            String?
  sourceImagePath  String?
  previewVideoPath String?
  finalVideoPath   String?
  videoUrl         String?
  seed             String?
  width            Int?
  height           Int?
  fps              Int?
  takes            Take[]
  jobs             GenerationJob[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([projectId])
}

model Take {
  id            String     @id @default(cuid())
  shot          Shot       @relation(fields: [shotId], references: [id], onDelete: Cascade)
  shotId        String
  versionNumber Int
  status        TakeStatus @default(GENERATING)
  fileUrl       String?
  seed          String?
  model         String?
  notes         String?
  createdAt     DateTime   @default(now())

  @@index([shotId])
}

model GenerationJob {
  id             String    @id @default(cuid())
  shot           Shot      @relation(fields: [shotId], references: [id], onDelete: Cascade)
  shotId         String
  type           JobType
  status         JobStatus @default(QUEUED)
  comfyPromptId  String?
  workflowPreset String?
  inputPath      String?
  outputPath     String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([shotId])
  @@index([status])
}

model AppSettings {
  id         String   @id
  apiBaseUrl String?
  apiKey     String?
  modelName  String?
  updatedAt  DateTime @updatedAt
}
