DATABASE_URL="file:./dev.db"

# Local ComfyUI integration. Export each workflow with File -> Export (API).
COMFY_URL=http://127.0.0.1:8188
COMFY_I2V_WORKFLOW_PATH=
COMFY_UPSCALE_WORKFLOW_PATH=

# Optional but strongly recommended. When configured, ShotDeck copies completed
# ComfyUI files into storage/ so they can be previewed and included in exports.
COMFY_OUTPUT_DIRECTORY=

# Required WAN I2V mapping for the documented WAN 2.2 workflow. IDs are strings,
# so colon-containing subgraph IDs such as 129:93 and 129:89 are valid.
COMFY_IMAGE_NODE=97
COMFY_IMAGE_INPUT=image
COMFY_POSITIVE_PROMPT_NODE=129:93
COMFY_POSITIVE_PROMPT_INPUT=text
COMFY_NEGATIVE_PROMPT_NODE=129:89
COMFY_NEGATIVE_PROMPT_INPUT=text
COMFY_OUTPUT_NODE=108
COMFY_OUTPUT_INPUT=filename_prefix

# Required mapping for the documented prompt-free upscale workflow.
COMFY_UPSCALE_VIDEO_NODE=1
COMFY_UPSCALE_VIDEO_INPUT=video
COMFY_UPSCALE_OUTPUT_NODE=4
COMFY_UPSCALE_OUTPUT_INPUT=filename_prefix

# Optional WAN I2V mappings for the documented workflow.
COMFY_SEED_NODE=129:86
COMFY_SEED_INPUT=noise_seed
COMFY_WIDTH_NODE=129:98
COMFY_WIDTH_INPUT=width
COMFY_HEIGHT_NODE=129:98
COMFY_HEIGHT_INPUT=height
COMFY_FPS_NODE=129:162
COMFY_FPS_INPUT=value
COMFY_DURATION_NODE=129:161
COMFY_DURATION_INPUT=value

# Optional mappings for the documented upscale workflow. Leave these blank when
# width, height, and frame rate should stay fixed in the exported JSON.
COMFY_UPSCALE_WIDTH_NODE=5
COMFY_UPSCALE_WIDTH_INPUT=width
COMFY_UPSCALE_HEIGHT_NODE=5
COMFY_UPSCALE_HEIGHT_INPUT=height
COMFY_UPSCALE_FPS_NODE=4
COMFY_UPSCALE_FPS_INPUT=frame_rate
