DATABASE_URL="file:./dev.db"

# Local ComfyUI integration. Export each workflow with File -> Export (API).
COMFY_URL=http://127.0.0.1:8188
COMFY_I2V_WORKFLOW_PATH=
COMFY_UPSCALE_WORKFLOW_PATH=

# Optional but strongly recommended. When configured, ShotDeck copies completed
# ComfyUI files into storage/ so they can be previewed and included in exports.
COMFY_OUTPUT_DIRECTORY=

# Required WAN I2V mapping. IDs are strings, so colon-containing subgraph IDs
# such as 129:93 and 129:89 are valid.
COMFY_IMAGE_NODE=
COMFY_IMAGE_INPUT=image
COMFY_POSITIVE_PROMPT_NODE=
COMFY_POSITIVE_PROMPT_INPUT=text
COMFY_NEGATIVE_PROMPT_NODE=
COMFY_NEGATIVE_PROMPT_INPUT=text
COMFY_OUTPUT_NODE=
COMFY_OUTPUT_INPUT=filename_prefix

# Required upscale mapping. The upscale workflow does not use prompt nodes.
COMFY_UPSCALE_VIDEO_NODE=
COMFY_UPSCALE_VIDEO_INPUT=video
COMFY_UPSCALE_OUTPUT_NODE=
COMFY_UPSCALE_OUTPUT_INPUT=filename_prefix

# Optional WAN I2V mappings
COMFY_SEED_NODE=
COMFY_SEED_INPUT=seed
COMFY_WIDTH_NODE=
COMFY_WIDTH_INPUT=width
COMFY_HEIGHT_NODE=
COMFY_HEIGHT_INPUT=height
COMFY_FPS_NODE=
COMFY_FPS_INPUT=fps
COMFY_DURATION_NODE=
COMFY_DURATION_INPUT=duration

# Optional upscale mappings. Leave blank when width, height, and frame rate are
# already fixed inside the exported upscale workflow.
COMFY_UPSCALE_WIDTH_NODE=
COMFY_UPSCALE_WIDTH_INPUT=width
COMFY_UPSCALE_HEIGHT_NODE=
COMFY_UPSCALE_HEIGHT_INPUT=height
COMFY_UPSCALE_FPS_NODE=
COMFY_UPSCALE_FPS_INPUT=frame_rate
