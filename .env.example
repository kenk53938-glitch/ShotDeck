# Copy this file to .env and fill in values as needed.
# .env is gitignored — nothing you put there gets committed.

DATABASE_URL="file:./dev.db"

# Optional. Enables AI-assisted shot-list parsing via the Gemini API.
# Get a free key at https://aistudio.google.com/apikey
# If unset, shot import falls back to the built-in rule-based parser.
GEMINI_API_KEY=
